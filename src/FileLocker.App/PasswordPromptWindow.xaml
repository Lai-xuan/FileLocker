                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <!-- UnlockButton 停用時，WPF 會把它整個排除在滑鼠命中測試之外（不只是不會
                         觸發 Click，連游標解析都不會落在它身上），按鈕自己身上設的 Cursor 完全
                         沒機會生效。外面包一層 Background="Transparent" 的 Border——這層永遠
                         在命中測試範圍內，按鈕被停用時滑鼠落在按鈕視覺範圍內，命中測試結果會
                         落到這層 Border，code-behind 把它的 Cursor 跟 UnlockButton.IsEnabled
                         同步切換，才能讓「不能按」的狀態真的顯示禁止游標。 -->
                    <Border x:Name="UnlockButtonHost" Background="Transparent">
                        <Button x:Name="UnlockButton" Content="解密" Style="{StaticResource PrimaryButtonStyle}" Click="UnlockButton_Click" IsDefault="True" IsEnabled="False" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 解鎖成功的收尾回饋：不透明卡片蓋滿整個內容區（跟卡片背景同色，視覺上像是內容
                 換掉了），淡入播放約半秒後 code-behind 就會 Close() 整個視窗，不是一個要使用者
                 額外等待/操作的獨立頁面。圖示比照 App.vue 的 toast 成功圖示（App.vue:1757，
                 描邊圓圈＋打勾），跟主視窗同一套視覺語言。 -->
            <Border x:Name="SuccessOverlay" Background="{DynamicResource SurfaceBrush}" Opacity="0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="40" Height="40" Margin="0,0,0,10">
                        <Canvas Width="20" Height="20">
                            <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="17" Height="17"
                                     Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.6" />
                            <Path Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6.5,10.2 L8.7,12.4 L13.5,7.4" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="解鎖成功" FontSize="15" FontWeight="SemiBold" FontFamily="./Assets/Fonts/#IBM Plex Sans TC SmBld, Segoe UI Semibold, Microsoft JhengHei UI, Microsoft JhengHei" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
            </Grid>
        </DockPanel>
    </Border>
