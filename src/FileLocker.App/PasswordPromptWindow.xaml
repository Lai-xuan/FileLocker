<Window x:Class="FileLocker.App.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileLocker" Width="440" SizeToContent="Height" MinHeight="280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="./Assets/Fonts/#IBM Plex Sans TC, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei"
        Background="{DynamicResource SurfaceBrush}"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
        無邊框視窗，跟主視窗（MainWindow）走同一套視覺語言，但技術做法刻意更單純：這個視窗
        ResizeMode="NoResize"、沒有最大化功能，不存在「拿掉原生標題列會失去最大化動畫」這個
        問題，所以不需要比照主視窗的 WindowStyle="SingleBorderWindow" + WM_NCCALCSIZE/
        WM_NCHITTEST。改用 WPF 最常見、風險最低的無邊框做法：WindowStyle="None"（不透明背景，
        不用 AllowsTransparency——不需要真的透明，維持不透明背景讓合成更輕量）+
        DwmSetWindowAttribute 要回 Windows 11 圓角（見 PasswordPromptWindow.xaml.cs 的
        TryRestoreRoundedCorners，跟 MainWindow.xaml.cs 是同一段邏輯，各自獨立呼叫）+ 自訂
        標題列上呼叫 WPF 原生的 DragMove() 拖曳視窗（不需要主視窗那套 WebView2 app-region
        機制，也不需要任何 P/Invoke）。

        刻意不設 Topmost="True"：Show() 本身就會讓新視窗取得前景焦點，不需要靠永久置頂才能
        被看到；永久置頂反而會擋住之後才彈出的系統對話框（實測發現 Windows Hello 的 Passkey
        驗證視窗會被這個視窗蓋住），拿掉可以徹底避免這整類問題，不只是 Passkey 這一個情境。

        沒有原生投影效果（拿掉標題列樣式的代價，跟主視窗一樣），這裡用一圈細邊框
        （BorderBrush，依主題切換）取代，不特別去接 DwmExtendFrameIntoClientArea 那套——
        這是個一次性彈出的小型任務對話框，不值得為了陰影效果多引入一層 P/Invoke 複雜度。

        SizeToContent="Height"：內容會因為模式切換（密碼/恢復金鑰/Passkey 驗證中/錯誤訊息）
        而變化，用固定高度容易「內容變少時留一大塊空白，或內容變多時被裁掉」，讓 WPF 自動
        貼合內容高度比手動猜一個固定值更穩妥。

        顏色/字體對齊 App.vue 的設計系統（:root、以及深色模式那組 CSS 變數）：色彩用
        DynamicResource 定義在下面 Window.Resources，依 AppSettings.Theme 由 code-behind
        （ApplyTheme）決定套用亮色或深色那組值，同一份 XAML 不用重複兩份。字體：內嵌
        IBM Plex Sans TC（Assets/Fonts/，只留 Regular/SemiBold/Bold 三個實際用到的字重，
        授權見同資料夾 license.txt）——這是網頁端 IBM Plex Sans 的正體中文版本，同一個字型
        家族，且 Regular 那個檔案本身內建完整拉丁字母（用 GlyphTypeface 實測確認過），英數字
        也直接吃這套字型，不用再靠 Segoe UI 補西文。Segoe UI／Microsoft JhengHei UI 留在
        fallback 清單最後面當保底，避免內嵌字型載入失敗時整段文字消失。SemiBold 字重的
        TextBlock（見下方「FileLocker」頁首標題、「解鎖成功」）額外覆寫 FontFamily 指到
        「IBM Plex Sans TC SmBld」（不是「...SemiBold」，這是這套字型實際的內部家族名稱，
        SemiBold 不在傳統 Regular/Bold 四字重連結模型內，字型檔案裡是獨立命名，用
        PrivateFontCollection 實際載入確認過，不是用命名慣例猜的）。

        Passkey／恢復金鑰圖示：直接把 Passkey_Black.svg／Recovery_Key_Black.svg 的路徑資料
        轉成 WPF Path/Ellipse（見下面 PasskeyIcon/RecoveryKeyIcon 這兩段 Viewbox），這兩個
        SVG 本身夠簡單（純 M/L/C 指令 + 一個 circle，WPF 的 Geometry mini-language 原生支援
        同一套語法），不值得為此引入 SharpVectors 這類 SVG 轉換套件多一層相依性。顏色一樣走
        DynamicResource，不用 Black/White 兩份幾何資料。
    -->

    <Window.Resources>
        <!-- 色彩資源：初始值是亮色主題，ApplyTheme 會在建構子依 AppSettings.Theme 覆寫成深色。
             全部用 DynamicResource 綁定，覆寫資源值會即時反映到已經算圖的畫面上。 -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#E1E4EA" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CDD6" />
        <SolidColorBrush x:Key="TextBrush" Color="#1B1E24" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#454A54" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B707A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A8770F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B14328" />
        <!-- 跟主視窗 App.vue 的 color-success 變數對齊（App.vue:1925,1963），解鎖成功的收尾動畫用。 -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D4F" />
        <!-- Passkey／恢復金鑰 chip 按鈕背景：比 SurfaceBrush 深一階、比 BorderStrongBrush 淡，
             用色塊本身區分「這是一塊獨立可點的區域」，不用邊框——這樣才會比取消/解密輕一級。 -->
        <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F1F2F5" />

        <!-- 扁平化按鈕：拿掉 WPF 預設的立體邊框視覺，圓角矩形 + hover 用透明度、press 額外加
             比照主視窗（.button:active { transform: scale(0.97) }）的按下縮小回饋——這個視窗
             生命週期雖短，但按下的那個瞬間回饋是操作中最常被感知到的部分，值得補。
             MinWidth 讓「取消」「解密」這類按鈕等寬，讀起來比隨文字長度各自不同更篤定；
             MinHeight 是明確保底（不是只靠 Padding 撐出高度），避免字型度量變動時高度跟著縮水。 -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="26,14" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- 之前這裡把 MinWidth 蓋回 0，理由是「Passkey／恢復金鑰按鈕不該被撐到跟取消/解密一樣寬」，
             但「取消」按鈕也套用同一個樣式，結果連它的 MinWidth 一起被蓋掉，變成三顆次要按鈕裡
             最窄的一顆（使用者反映取消按鈕看起來比較窄，根因就是這裡）。改成不在樣式層蓋掉，
             Passkey／恢復金鑰按鈕改在各自的 Button 上直接寫 MinWidth="0"（見下方，且反正它們
             已經 Stretch 拉滿整行寬度，MinWidth 對它們基本沒有視覺影響）。 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>

        <!-- Passkey／恢復金鑰用：刻意比 SecondaryButtonStyle 輕一級（矮、字小、無邊框、淡底），
             讓使用者一眼看出這是「密碼以外的捷徑」，不是跟取消/解密同等重要的主要動作。
             份量降低是靠「無邊框＋矮＋淡底」達成，不是靠淡化文字顏色——原本用
             TextSecondaryBrush 導致小字級下對比度不足，改回 TextBrush（跟其他按鈕文字一樣深）。
             MinWidth 蓋回 0——這兩顆是左右並排的 chip，寬度交給外層 Grid 的 * 欄位平均分配，
             不需要各自撐出最小寬度。 -->
        <Style x:Key="TertiaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- 「返回使用密碼」連結：切到恢復金鑰這個「頁面」之後，讓使用者能回頭改用密碼——
             不是按鈕，是連結的份量（無邊框無底色，只有文字＋hover 底線），因為這是離開目前
             畫面的次要動作，不該跟「解密」搶視覺重量。 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <ContentPresenter />
                            <Border x:Name="Underline" Height="1" Margin="0,2,0,0"
                                    Background="{TemplateBinding Foreground}" Opacity="0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左上角紅色圓形關閉鈕，比照主視窗的關閉圓形按鈕（#FF5F57，12px），滑鼠移上去時
             比照 macOS 交通燈按鈕顯示一個 × 符號，讓使用者知道這顆是可以點的關閉鈕，不是
             純裝飾的色塊。用 Button（不是純 Ellipse）是刻意的：Button 的滑鼠按下事件會被
             自己吃掉、不會繼續冒泡到外層標題列的 MouseLeftButtonDown，點下去才不會被誤判成
             在拖曳視窗。 -->
        <Style x:Key="TrafficLightCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#FF5F57" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                            <TextBlock x:Name="Glyph" Text="&#x2715;" FontSize="8" FontWeight="Bold"
                                       Foreground="#7A1300" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 欄位標籤，比照主視窗表單 .field__label 的風格。 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- PART_ContentHost 是 PasswordBox 範本的硬性規定名稱，少了它密碼輸入框不會真的顯示輸入內容。 -->
        <Style x:Key="FlatPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 恢復金鑰輸入框：跟密碼欄位同一套視覺（邊框/圓角/聚焦色），但明碼多行——恢復金鑰
             不是要遮罩的機密輸入（使用者需要核對自己抄的對不對），比照主視窗 recoveryKeyPrompt
             用等寬字體的多行文字框。 -->
        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Height" Value="42" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="38" Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="CloseTrafficLight" Style="{StaticResource TrafficLightCloseStyle}" Click="CancelButton_Click" />
                    <TextBlock Text="FileLocker" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" FontFamily="./Assets/Fonts/#IBM Plex Sans TC SmBld, Segoe UI Semibold, Microsoft JhengHei UI, Microsoft JhengHei" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Grid>

            <!-- 內容區改成 Grid，讓解鎖成功的收尾動畫（SuccessOverlay）可以疊在 MainContentPanel
                 上面，而不是把內容換掉——這個視窗是 SizeToContent="Height"，換內容會讓窗高
                 在使用者眼前跳動，疊加層底下的 MainContentPanel 還在，Grid 版面量測不受影響。 -->
            <Grid>
            <StackPanel x:Name="MainContentPanel" Margin="24">
                <TextBlock x:Name="FileNameText" FontWeight="SemiBold" FontSize="20" FontFamily="./Assets/Fonts/#IBM Plex Sans TC SmBld, Segoe UI Semibold, Microsoft JhengHei UI, Microsoft JhengHei" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="HintText" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock x:Name="PasskeyStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock x:Name="PasswordFieldLabel" Text="密碼" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource FlatPasswordBoxStyle}" PasswordChanged="PasswordInput_PasswordChanged" />

                <!-- 切到恢復金鑰模式後，這是唯一的回頭路——份量刻意比按鈕輕（見 LinkButtonStyle
                     說明），因為離開目前畫面是次要動作，不該跟「解密」搶視覺重量。 -->
                <Button x:Name="BackToPasswordButton" Content="&#x2190; 返回使用密碼" Style="{StaticResource LinkButtonStyle}"
                        Margin="0,0,0,12" Click="BackToPasswordButton_Click" Visibility="Collapsed" />

                <TextBlock x:Name="RecoveryKeyFieldLabel" Text="恢復金鑰" Style="{StaticResource FieldLabelStyle}" Visibility="Collapsed" />
                <TextBox x:Name="RecoveryKeyInput" Style="{StaticResource FlatTextBoxStyle}" Visibility="Collapsed" TextChanged="RecoveryKeyInput_TextChanged" />

                <!-- 「或」分隔線：明確標出下面是密碼以外的另一條路，是登入表單常見的分組模式
                     （帳密欄位 → 分隔線 → 並排的替代登入捷徑），比讓使用者自己猜三顆按鈕的
                     關係更直覺。Visibility 由 code-behind 依是否有任何替代解鎖方式決定，
                     兩者都沒開時不該平白多一條線。 -->
                <Grid x:Name="AltAuthDivider" Margin="0,18,0,14" Visibility="Collapsed">
                    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="或" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11.5" Padding="10,0" HorizontalAlignment="Center" />
                </Grid>

                <!-- Passkey／恢復金鑰：密碼以外的解鎖捷徑，左右並排、套用比 SecondaryButtonStyle
                     輕一級的 TertiaryButtonStyle（見 Window.Resources 說明），視覺上明顯次於
                     底下的取消/解密。只開其中一種時，code-behind 會把該按鈕的 Grid.ColumnSpan
                     設成 2，撐滿整行，不會留一半空白。 -->
                <Grid x:Name="AltAuthGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PasskeyButton" Grid.Column="0" Style="{StaticResource TertiaryButtonStyle}" Margin="0,0,5,0"
                            Click="PasskeyButton_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Canvas Width="1024" Height="1024">
                                    <Ellipse Canvas.Left="236.2792912208" Canvas.Top="139.5863291823" Width="352.9695694086" Height="352.9695694086" Fill="{DynamicResource TextBrush}" />
                                    <Path Fill="{DynamicResource TextBrush}"
                                          Data="M110.2186602587,720.6385116275L110.2186602587,672.4359486213C110.2186602587,606.3392511239 199.9314866801,552.6771187943 310.4325288895,552.6771187943L433.641053828,552.6771187943C461.7584457338,552.6771187943 488.5298702544,556.1515622323 512.8197929735,562.4212240684C524.5679740922,580.4791992171 544.1058242963,596.2168573563 568.9589347037,608.1541196815L568.9589347037,720.6385116275L110.2186602587,720.6385116275Z">
                                        <Path.RenderTransform>
                                            <MatrixTransform Matrix="1.123457,0,0,1.878205,-8.203184,-489.363828" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <Path Fill="{DynamicResource TextBrush}"
