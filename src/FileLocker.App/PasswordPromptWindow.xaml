<Window x:Class="FileLocker.App.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileLocker" Height="320" Width="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource SurfaceBrush}"
        SourceInitialized="Window_SourceInitialized">

    <!--
        無邊框視窗，跟主視窗（MainWindow）走同一套視覺語言，但技術做法刻意更單純：這個視窗
        ResizeMode="NoResize"、沒有最大化功能，不存在「拿掉原生標題列會失去最大化動畫」這個
        問題，所以不需要比照主視窗的 WindowStyle="SingleBorderWindow" + WM_NCCALCSIZE/
        WM_NCHITTEST。改用 WPF 最常見、風險最低的無邊框做法：WindowStyle="None"（不透明背景，
        不用 AllowsTransparency——不需要真的透明，維持不透明背景讓合成更輕量）+
        DwmSetWindowAttribute 要回 Windows 11 圓角（見 PasswordPromptWindow.xaml.cs 的
        TryRestoreRoundedCorners，跟 MainWindow.xaml.cs 是同一段邏輯，各自獨立呼叫）+ 自訂
        標題列上呼叫 WPF 原生的 DragMove() 拖曳視窗（不需要主視窗那套 WebView2 app-region
        機制，也不需要任何 P/Invoke）。

        沒有原生投影效果（拿掉標題列樣式的代價，跟主視窗一樣），這裡用一圈細邊框
        （BorderBrush，依主題切換）取代，不特別去接 DwmExtendFrameIntoClientArea 那套——
        這是個一次性彈出的小型任務對話框，不值得為了陰影效果多引入一層 P/Invoke 複雜度。

        顏色/字體對齊 App.vue 的設計系統（:root、以及深色模式那組 CSS 變數）：色彩用
        DynamicResource 定義在下面 Window.Resources，依 AppSettings.Theme 由 code-behind
        （ApplyTheme）決定套用亮色或深色那組值，同一份 XAML 不用重複兩份。字體例外：
        IBM Plex Sans 目前只有 @fontsource 的 woff/woff2 檔，WPF 不支援 woff 容器格式，
        專案裡沒有可以直接嵌入的 ttf/otf，改用 Segoe UI——這正是 App.vue 的字體變數
        本身宣告的下一順位字體（'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif），
        不是隨便選的替代品。
    -->

    <Window.Resources>
        <!-- 色彩資源：初始值是亮色主題，ApplyTheme 會在建構子依 AppSettings.Theme 覆寫成深色。
             全部用 DynamicResource 綁定，覆寫資源值會即時反映到已經算圖的畫面上。 -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#E1E4EA" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CDD6" />
        <SolidColorBrush x:Key="TextBrush" Color="#1B1E24" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#454A54" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B707A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A8770F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B14328" />

        <!-- 扁平化按鈕：拿掉 WPF 預設的立體邊框視覺，圓角矩形 + hover/press 用透明度做回饋
             （這個視窗生命週期很短，不值得為了 hover 效果額外做過渡動畫）。 -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>

        <!-- 左上角紅色圓形關閉鈕，比照主視窗的關閉圓形按鈕（#FF5F57，12px）。
             用 Button（不是純 Ellipse）是刻意的：Button 的滑鼠按下事件會被自己吃掉、不會
             繼續冒泡到外層標題列的 MouseLeftButtonDown，點下去才不會被誤判成在拖曳視窗。 -->
        <Style x:Key="TrafficLightCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#FF5F57" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PART_ContentHost 是 PasswordBox 範本的硬性規定名稱，少了它密碼輸入框不會真的顯示輸入內容。 -->
        <Style x:Key="FlatPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="38" Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="CloseTrafficLight" Style="{StaticResource TrafficLightCloseStyle}" Click="CancelButton_Click" />
                    <TextBlock Text="FileLocker" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="20,10,20,20">
                <TextBlock x:Name="FileNameText" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="HintText" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />

                <TextBlock x:Name="PasskeyStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />

                <Button x:Name="PasskeyButton" Content="使用 Passkey 解鎖" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="PasskeyButton_Click" Visibility="Collapsed" />

                <PasswordBox x:Name="PasswordInput" Style="{StaticResource FlatPasswordBoxStyle}" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click" />
                    <Button x:Name="UnlockButton" Content="解密" Style="{StaticResource PrimaryButtonStyle}" Click="UnlockButton_Click" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
