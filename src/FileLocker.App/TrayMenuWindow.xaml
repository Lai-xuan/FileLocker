<Window x:Class="FileLocker.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileLocker" Width="200" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="./Assets/Fonts/#IBM Plex Sans TC, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei"
        Background="{DynamicResource SurfaceBrush}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed">

    <!--
        系統匣圖示右鍵選單——技術結構比照 FolderGuardUnlockPromptWindow（無邊框、
        DwmSetWindowAttribute 圓角），但這是彈出選單不是對話框：WindowStartupLocation
        改成 Manual（定位在游標附近，見 TrayIconManager／Window_SourceInitialized），
        多了 Deactivated 自動收起、沒有拖曳標題列。改用真正的 WPF 視窗（不是 WinForms
        ContextMenuStrip）是因為 DWM 圓角套用在 WinForms 的 GDI 彈出視窗上會造成殘影
        （ToolStripDropDown 不是 DWM 合成表面，圓角裁切的角落區域會顯示沒有正確失效的
        殘留畫面內容）；WPF 視窗本來就是正常的 DWM 合成表面，不會有這個問題。
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#E1E4EA" />
        <SolidColorBrush x:Key="TextBrush" Color="#1B1E24" />
        <SolidColorBrush x:Key="AccentTintBrush" Color="#F5EBD6" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#E1E4EA" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B14328" />

        <Style x:Key="TrayMenuItemStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="6,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuDangerItemStyle" TargetType="Button" BasedOn="{StaticResource TrayMenuItemStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style x:Key="TrayMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="10,6" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <StackPanel Margin="0,4">
            <Button x:Name="OpenButton" Content="開啟 FileLocker" Style="{StaticResource TrayMenuItemStyle}" Click="OpenButton_Click" />
            <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
            <Button x:Name="EncryptButton" Content="加密" Style="{StaticResource TrayMenuItemStyle}" Click="EncryptButton_Click" />
            <Button x:Name="ListButton" Content="已加密清單" Style="{StaticResource TrayMenuItemStyle}" Click="ListButton_Click" />
            <Button x:Name="FolderGuardButton" Content="資料夾防護" Style="{StaticResource TrayMenuItemStyle}" Click="FolderGuardButton_Click" />
            <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />
            <Button x:Name="ExitButton" Content="結束 FileLocker" Style="{StaticResource TrayMenuDangerItemStyle}" Click="ExitButton_Click" />
        </StackPanel>
    </Border>
</Window>
