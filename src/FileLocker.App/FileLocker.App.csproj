<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FileLocker.Core\FileLocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    只有 Release 建置才需要打包前端靜態檔案——Debug 建置照舊連到 Vite 開發伺服器
    （見 MainWindow.xaml.cs 裡的 #if DEBUG 分支），不需要每次 Debug 建置都重跑一次
    npm run build，開發起來才不會變慢。

    這兩個 Target 依序執行：先在 FileLocker.Web 資料夾跑 npm run build 產生 dist/，
    再把 dist/ 底下所有檔案複製進這個專案的輸出目錄下的 webapp/ 資料夾——
    正式執行時 MainWindow 會用 SetVirtualHostNameToFolderMapping 指向這個 webapp 資料夾。
  -->
  <Target Name="BuildWebFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm run build" WorkingDirectory="..\FileLocker.Web" />
  </Target>

  <Target Name="CopyWebAppForRelease" AfterTargets="BuildWebFrontend" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <WebAppFiles Include="..\FileLocker.Web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)" DestinationFolder="$(OutDir)webapp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Shell Extension 是獨立的 C++ 專案，用 cl.exe 手動編譯（見規格文件第 5.2 節），不屬於這個
    .NET 建置圖，MSBuild 不會自動幫忙編譯它。這裡只負責「如果那邊已經手動編出 DLL了，
    就複製一份放到跟 FileLocker.App.exe 同一個資料夾」——ShellExtensionRegistrar 靠這個
    同資料夾的檔案才能自動完成登錄，不管 Debug 還是 Release 建置都需要這份複製。
    找不到來源 DLL（例如還沒手動編譯過）不會讓建置失敗，單純跳過這個步驟。
  -->
  <Target Name="CopyShellExtensionDll" AfterTargets="Build">
    <ItemGroup>
      <ShellExtensionDll Include="..\FileLocker.ShellExtension\FileLockerShellExtension.dll" Condition="Exists('..\FileLocker.ShellExtension\FileLockerShellExtension.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ShellExtensionDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(ShellExtensionDll)' != ''" />
  </Target>

</Project>