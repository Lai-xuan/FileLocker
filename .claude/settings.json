{
  "permissions": {
    "allow": [
      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-test.sh"
          }
        ]
      }
    ]
  }
}