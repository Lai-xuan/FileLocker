<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FileLocker.Core\FileLocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\IBMPlexSansTC-Regular.ttf" />
    <Resource Include="Assets\Fonts\IBMPlexSansTC-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\IBMPlexSansTC-Bold.ttf" />
  </ItemGroup>

  <!-- `.lockfolder` 標記檔的圖示：獨立 .ico 檔（不是借用主程式圖示），需要跟著建置輸出、
       跟著 dotnet publish 一起打包，ShellExtensionRegistrar 註冊 DefaultIcon 時才找得到。 -->
  <ItemGroup>
    <Content Include="LockFolderMarker.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    只有 Release 建置才需要打包前端靜態檔案——Debug 建置照舊連到 Vite 開發伺服器
    （見 MainWindow.xaml.cs 裡的 #if DEBUG 分支），不需要每次 Debug 建置都重跑一次
    npm run build，開發起來才不會變慢。

    這兩個 Target 依序執行：先在 FileLocker.Web 資料夾跑 npm run build 產生 dist/，
    再把 dist/ 底下所有檔案複製進這個專案的輸出目錄下的 webapp/ 資料夾——
    正式執行時 MainWindow 會用 SetVirtualHostNameToFolderMapping 指向這個 webapp 資料夾。
  -->
  <Target Name="BuildWebFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm run build" WorkingDirectory="..\FileLocker.Web" />
  </Target>

  <Target Name="CopyWebAppForRelease" AfterTargets="BuildWebFrontend" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <WebAppFiles Include="..\FileLocker.Web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)" DestinationFolder="$(OutDir)webapp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Shell Extension 是獨立的 C++ 專案，用 cl.exe 手動編譯（見規格文件第 5.2 節），不屬於這個
    .NET 建置圖，MSBuild 不會自動幫忙編譯它。這裡只負責「如果那邊已經手動編出 DLL了，
    就複製一份放到跟 FileLocker.App.exe 同一個資料夾」——ShellExtensionRegistrar 靠這個
    同資料夾的檔案才能自動完成登錄，不管 Debug 還是 Release 建置都需要這份複製。
    找不到來源 DLL（例如還沒手動編譯過）不會讓建置失敗，單純跳過這個步驟。
  -->
  <Target Name="CopyShellExtensionDll" AfterTargets="Build">
    <ItemGroup>
      <ShellExtensionDll Include="..\FileLocker.ShellExtension\FileLockerShellExtension.dll" Condition="Exists('..\FileLocker.ShellExtension\FileLockerShellExtension.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ShellExtensionDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(ShellExtensionDll)' != ''" />
  </Target>

  <!--
    dotnet publish 產生 publish/ 資料夾用的是自己一套「要發佈哪些檔案」的清單機制（ComputeFilesToPublish），
    不會自動把 CopyShellExtensionDll 在 Build 階段丟進 $(OutDir) 的檔案一起帶過去——這裡用 MSBuild
    標準做法（BeforeTargets="ComputeFilesToPublish" 塞 ResolvedFileToPublish 項目）讓它也進到
    publish 輸出，不然照安裝程式打包 publish 資料夾的話，Shell Extension DLL 會整個漏掉。
  -->
  <Target Name="AddShellExtensionDllToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="Exists('..\FileLocker.ShellExtension\FileLockerShellExtension.dll')">
    <ItemGroup>
      <ResolvedFileToPublish Include="..\FileLocker.ShellExtension\FileLockerShellExtension.dll">
        <RelativePath>FileLockerShellExtension.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    同樣的道理：CopyWebAppForRelease 在 Build 階段把 dist/ 複製進 $(OutDir)webapp/，dotnet publish
    一樣不會自動把它帶進 publish/ 資料夾——執行期 MainWindow 靠 SetVirtualHostNameToFolderMapping
    指向這個資料夾載入前端畫面，找不到就會跳出「找不到前端畫面檔案」的錯誤視窗。跟 Shell Extension
    DLL 同一招，直接從來源 dist/ 登記 ResolvedFileToPublish，RelativePath 保留 webapp/ 底下的
    原始資料夾結構（%(RecursiveDir)）。
  -->
  <Target Name="AddWebAppToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\FileLocker.Web\dist')">
    <ItemGroup>
      <WebAppFilesForPublish Include="..\FileLocker.Web\dist\**\*.*" />
      <ResolvedFileToPublish Include="@(WebAppFilesForPublish)">
        <RelativePath>webapp\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    CLI（FileLocker.Cli）跟 GUI 是各自獨立的建置產物，之前完全沒有被納入安裝內容，見規格文件
    第 21 節。這裡比照上面 webapp/ 的三段式做法：Build 階段先另外 dotnet build 出 CLI，複製到
    輸出目錄下的 cli/ 子資料夾，再讓 dotnet publish 也把這個子資料夾一起帶走。

    放獨立子資料夾、不是跟 GUI 混在同一層：CLI 自己有一份完整的相依 DLL（FileLocker.Core.dll
    等），跟 GUI 那份是分開建置出來的兩份拷貝，混在同一個資料夾容易撞名或載到錯的版本
    （.NET framework-dependent 部署靠同資料夾內的 DLL 探測）。獨立子資料夾也剛好搭配安裝程式
    新加的 path_target_exe 欄位——加入系統 PATH 的只有 cli/ 這一層，不會把 GUI 那堆 DLL
    所在的安裝根目錄整個暴露進使用者的 PATH。
  -->
  <Target Name="BuildCli" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="dotnet build ..\FileLocker.Cli\FileLocker.Cli.csproj -c Release" />
  </Target>

  <Target Name="CopyCliForRelease" AfterTargets="BuildCli" Condition="'$(Configuration)' == 'Release'">
    <!--
      Exclude 排掉 Cli 自己輸出目錄裡可能存在的 publish\ 子資料夾——如果有人對 FileLocker.Cli
      單獨跑過 dotnet publish，它自己的 bin\Release\...\ 底下就會多一份 publish\ 子資料夾，
      這裡的 **\*.* 萬用字元不排除的話會把那份也一起遞迴掃進來，複製出巢狀重複的內容
      （cli\publish\... 裡面又是一份完整拷貝）。
    -->
    <ItemGroup>
      <CliFiles Include="..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\**\*.*"
                Exclude="..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)cli\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddCliToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0')">
    <ItemGroup>
      <CliFilesForPublish Include="..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\**\*.*"
                           Exclude="..\FileLocker.Cli\bin\Release\net10.0-windows10.0.19041.0\publish\**\*.*" />
      <ResolvedFileToPublish Include="@(CliFilesForPublish)">
        <RelativePath>cli\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>